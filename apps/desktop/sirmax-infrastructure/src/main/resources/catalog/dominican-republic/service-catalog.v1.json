    "permiso_con_inspeccion": {
      "defaultSlaDays": 30,
      "workflow": {
        "firstStepKey": "solicitud",
        "steps": [
          { "key": "solicitud", "label": "Recepción de la solicitud", "type": "TASK", "slaDays": 2,
            "transitions": [ { "kind": "ADVANCE", "to": "revision_tecnica" }, { "kind": "CANCEL" } ] },
          { "key": "revision_tecnica", "label": "Revisión técnica", "type": "REVIEW",
            "requiredPermission": "procedure.work", "slaDays": 10,
            "transitions": [
              { "kind": "ADVANCE", "to": "inspeccion" },
              { "kind": "RETURN_FOR_CORRECTION", "to": "solicitud" },
              { "kind": "REJECT" } ] },
          { "key": "inspeccion", "label": "Inspección de campo", "type": "INSPECTION", "slaDays": 7,
            "transitions": [
              { "kind": "ADVANCE", "to": "aprobacion" },
              { "kind": "RETURN_FOR_CORRECTION", "to": "revision_tecnica" } ] },
          { "key": "aprobacion", "label": "Aprobación", "type": "APPROVAL",
            "requiredPermission": "procedure.decide", "slaDays": 5,
            "transitions": [ { "kind": "ADVANCE", "to": "pago" }, { "kind": "REJECT" } ] },
          { "key": "pago", "label": "Pago de la tasa", "type": "PAYMENT_CHECKPOINT", "slaDays": 5,
            "transitions": [ { "kind": "ADVANCE", "to": "emision" }, { "kind": "CANCEL" } ] },
          { "key": "emision", "label": "Emisión del permiso", "type": "DOCUMENT_OUTPUT", "slaDays": 0,
            "transitions": [ { "kind": "APPROVE" } ] }
        ]
      }
    },
    "reclamacion": {
      "defaultSlaDays": 10,
      "workflow": {
        "firstStepKey": "recepcion",
        "steps": [
          { "key": "recepcion", "label": "Recepción del reporte", "type": "TASK", "slaDays": 1,
            "transitions": [ { "kind": "ADVANCE", "to": "gestion" }, { "kind": "CANCEL" } ] },
          { "key": "gestion", "label": "Gestión y respuesta", "type": "TASK", "slaDays": 7,
