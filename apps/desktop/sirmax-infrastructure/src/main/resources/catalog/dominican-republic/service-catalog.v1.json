  "workflowTemplates": {
    "pago_directo": {
      "defaultSlaDays": 1,
      "workflow": {
        "firstStepKey": "registro",
        "steps": [
          { "key": "registro", "label": "Registro del cobro", "type": "TASK", "slaDays": 1,
