          { "key": "cobro", "label": "Cobro en caja", "type": "PAYMENT_CHECKPOINT", "slaDays": 1,
            "transitions": [ { "kind": "ADVANCE", "to": "recibo" }, { "kind": "CANCEL" } ] },
          { "key": "recibo", "label": "Emisión del recibo", "type": "DOCUMENT_OUTPUT", "slaDays": 0,
            "transitions": [ { "kind": "APPROVE" } ] }
        ]
      }
    },
    "certificacion_simple": {
      "defaultSlaDays": 3,
      "workflow": {
        "firstStepKey": "solicitud",
        "steps": [
          { "key": "solicitud", "label": "Recepción de la solicitud", "type": "TASK", "slaDays": 1,
