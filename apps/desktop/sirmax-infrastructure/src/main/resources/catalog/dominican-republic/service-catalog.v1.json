              { "kind": "ADVANCE", "to": "cierre" },
              { "kind": "RETURN_FOR_CORRECTION", "to": "recepcion" } ] },
          { "key": "cierre", "label": "Cierre y verificación", "type": "REVIEW", "slaDays": 2,
            "transitions": [
              { "kind": "APPROVE" },
              { "kind": "RETURN_FOR_CORRECTION", "to": "gestion" } ] }
        ]
      }
    },
    "contrato_arrendamiento": {
      "defaultSlaDays": 15,
      "workflow": {
        "firstStepKey": "solicitud",
        "steps": [
          { "key": "solicitud", "label": "Recepción de la solicitud", "type": "TASK", "slaDays": 2,
            "transitions": [ { "kind": "ADVANCE", "to": "verificacion" }, { "kind": "CANCEL" } ] },
          { "key": "verificacion", "label": "Verificación de requisitos", "type": "REVIEW", "slaDays": 5,
