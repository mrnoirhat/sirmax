              { "kind": "ADVANCE", "to": "emision" },
              { "kind": "RETURN_FOR_CORRECTION", "to": "solicitud" },
              { "kind": "REJECT" } ] },
          { "key": "emision", "label": "Emisión del documento", "type": "DOCUMENT_OUTPUT", "slaDays": 0,
            "transitions": [ { "kind": "APPROVE" } ] }
        ]
      }
    },
    "certificacion_con_pago": {
      "defaultSlaDays": 5,
      "workflow": {
        "firstStepKey": "solicitud",
        "steps": [
          { "key": "solicitud", "label": "Recepción de la solicitud", "type": "TASK", "slaDays": 1,
            "transitions": [ { "kind": "ADVANCE", "to": "verificacion" }, { "kind": "CANCEL" } ] },
          { "key": "verificacion", "label": "Verificación de requisitos", "type": "REVIEW", "slaDays": 2,
