# Normalize line endings across the monorepo.
* text=auto eol=lf

# Windows-native scripts must keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Gradle wrapper script stays LF even on Windows checkouts.
gradlew text eol=lf

# Binary assets — never diff or normalize.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.jar   binary
*.msi   binary
*.exe   binary
*.sqlite binary

# Language stats: don't count vendored / generated dirs.
apps/docs/build/**      linguist-generated
apps/landing/.next/**   linguist-generated
